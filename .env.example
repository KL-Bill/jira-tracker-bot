# Discord — from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id-here
# Optional: for instant command registration during testing (guild-scoped).
# Leave blank to register globally instead (takes up to 1 hour to propagate).
DISCORD_GUILD_ID=your-server-id-here

# Jira — https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://hristmc.atlassian.net
JIRA_EMAIL=your-jira-login-email@example.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=KAN

# Project timeline — used to compute "Week X of Y"
PROJECT_START_DATE=2026-09-14
PROJECT_TOTAL_WEEKS=17
